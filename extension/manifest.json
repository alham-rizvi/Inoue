{
  "manifest_version": 3,
  "name": "Inoue Web Stack Detector",
  "version": "1.0.0",
  "description": "Detect the technology stack exposed by the active web page using a local Inoue Python backend.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Detect web stack",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "inoue-web-stack-detector@alhamrizvi.in",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
